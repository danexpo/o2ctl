# Glorious Model O 2 Wireless: let the logged-in user configure it.
# 093a:822d = 2.4 GHz dongle, 093a:822a = USB cable.
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="093a", ATTRS{idProduct}=="822d", TAG+="uaccess"
KERNEL=="hidraw*", SUBSYSTEM=="hidraw", ATTRS{idVendor}=="093a", ATTRS{idProduct}=="822a", TAG+="uaccess"
